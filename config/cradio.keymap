#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define COLEMAK 0
#define QWE 1
#define NAV 2
#define FN 3
#define SYM 4
#define NUM 5
#define DIA 6
#define QDI 7

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
    quick_tap_ms = <75>;
};

/ {
    combos {
        compatible = "zmk,combos";

        qwerty {
            bindings = <&tog QWE>;
            key-positions = <0 9>;
        };
    };

    macros {
        dozenal_ten: dozenal_ten {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(U)) &kp NUMBER_2 &kp NUMBER_1 &kp N8 &kp A &kp ENTER>;
        };

        dozenal_elf: dozenal_elf {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(U)) &kp N2 &kp N1 &kp N8 &kp B &kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LEFT_ALT Q    &kp W  &kp F      &kp P                 &kp B             &kp J           &kp L          &kp U      &kp Y    &kp PERIOD
&kp A             &kp R  &lt NUM S  &lt NAV T             &kp G             &kp M           &lt FN N       &lt SYM E  &kp I    &kp O
&mt LEFT_SHIFT X  &kp C  &kp D      &kp V                 &kp Z             &kp K           &kp H          &kp COMMA  &sl DIA  &mt CAPS FSLH
                                    &mt LEFT_CONTROL TAB  &mt LGUI SPACE    &mt LSHIFT RET  &kp BACKSPACE
            >;
        };

        qwerty_layer {
            bindings = <
&mt LEFT_ALT Q    &kp W  &kp E      &kp R      &kp T     &kp Y   &kp U      &kp I     &kp O    &kp P
&kp A             &kp S  &lt NUM D  &lt NAV F  &kp G     &kp H   &lt FN J   &lt SYM K &kp L    &kp DOT
&mt LEFT_SHIFT Z  &kp X  &kp C      &kp V      &kp B     &kp N   &kp M      &trans    &sl QDI  &trans
                                    &trans     &trans    &trans  &trans
            >;
        };

        nav_layer {
            bindings = <
&trans  &trans  &trans  &trans  &kp HOME    &kp ESC           &kp LEFT_PARENTHESIS  &kp UP_ARROW  &kp RIGHT_PARENTHESIS  &kp PAGE_UP
&trans  &trans  &trans  &trans  &trans      &kp LEFT_BRACE    &kp LEFT              &kp DOWN      &kp RIGHT              &kp RIGHT_BRACE
&trans  &trans  &trans  &trans  &kp END     &kp LEFT_BRACKET  &kp LESS_THAN         &kp RBKT      &kp GREATER_THAN       &kp PAGE_DOWN
                        &trans  &kp LGUI    &kp DELETE        &kp BSPC
            >;
        };

        fn_layer {
            bindings = <
&kp K_PREV         &kp F1        &kp F2      &kp F3       &kp K_NEXT          &trans  &trans       &trans  &trans  &trans
&kp C_VOLUME_DOWN  &kp F5        &kp F6      &kp F12      &kp C_VOLUME_UP     &trans  &trans       &trans  &trans  &trans
&bt BT_PRV         &out OUT_TOG  &bt BT_CLR  &bootloader  &bt BT_NXT          &trans  &bootloader  &trans  &trans  &trans
                                             &kp K_MUTE   &kp K_PLAY_PAUSE    &trans  &trans
            >;
        };

        sym_layer {
            bindings = <
&kp SQT    &kp TILDE  &kp STAR   &kp AMPS  &kp KP_EQUAL      &sys_reset  &bootloader  &trans  &trans  &trans
&kp DQT    &kp CARET  &kp PRCNT  &kp DLLR  &kp SEMICOLON     &trans      &trans       &trans  &trans  &trans
&kp GRAVE  &kp HASH   &kp AT     &kp EXCL  &kp BACKSLASH     &trans      &trans       &trans  &trans  &trans
                                 &kp PIPE  &kp UNDERSCORE    &trans      &trans
            >;
        };

        num_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans        &kp MINUS     &kp N7         &kp N8  &kp N9  &kp PLUS
&trans  &trans  &trans  &trans  &trans        &kp ASTERISK  &kp N4         &kp N5  &kp N6  &dozenal_ten
&trans  &trans  &trans  &trans  &trans        &kp SLASH     &kp N1         &kp N2  &kp N3  &dozenal_elf
                        &trans  &kp PERIOD    &kp NUMBER_0  &kp BACKSPACE
            >;
        };

        diacritics_layer {
            bindings = <
&trans     &trans     &trans     &trans  &trans       &trans  &kp RA(L)  &trans     &trans  &trans
&kp RA(A)  &trans     &kp RA(S)  &trans  &trans       &trans  &kp RA(N)  &kp RA(E)  &trans  &kp RA(O)
&kp RA(X)  &kp RA(C)  &trans     &trans  &kp RA(Z)    &trans  &trans     &trans     &trans  &trans
                                 &trans  &trans       &trans  &trans
            >;
        };

        qwerty_diacritics_layer {
            bindings = <
&trans     &trans     &kp RA(E)  &trans  &trans    &trans     &trans  &trans  &kp RA(O)  &trans
&kp RA(A)  &kp RA(S)  &trans     &trans  &trans    &trans     &trans  &trans  &kp RA(L)  &trans
&kp RA(Z)  &kp RA(X)  &kp RA(C)  &trans  &trans    &kp RA(N)  &trans  &trans  &trans     &trans
                                 &trans  &trans    &trans     &trans
            >;
        };
    };
};
